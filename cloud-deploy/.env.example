# ============================================================
# Environment Variables for Cloud Deployment
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Database (PostgreSQL for cloud) ----
# Get this from your database provider (Render, Supabase, etc.)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# For local development (XAMPP MySQL), leave DATABASE_URL empty and set these instead:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=process_automation_db

# ---- Server ----
NODE_ENV=production
PORT=3001

# ---- CORS (optional: restrict to your frontend domain) ----
# FRONTEND_URL=https://your-site.netlify.app
