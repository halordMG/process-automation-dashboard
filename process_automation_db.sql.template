-- ============================================================
-- TRIGGERS
-- ============================================================

DELIMITER //

-- Auto-log project creation
CREATE TRIGGER trg_project_created
AFTER INSERT ON projects
FOR EACH ROW
BEGIN
    INSERT INTO activity_logs (user_id, user_name, project_id, project_name, action_type, description)
    VALUES (NEW.created_by, NEW.owner_name, NEW.id, NEW.project_name, 'create',
            CONCAT('Project created: ', NEW.project_name));
END //

-- Auto-log project updates
CREATE TRIGGER trg_project_updated
AFTER UPDATE ON projects
FOR EACH ROW
BEGIN
    INSERT INTO activity_logs (user_id, user_name, project_id, project_name, action_type, description)
    VALUES (NEW.created_by, NEW.owner_name, NEW.id, NEW.project_name, 'update',
            CONCAT('Project updated: ', NEW.project_name));
END //

DELIMITER ;
