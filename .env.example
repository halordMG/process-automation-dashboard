# Process Automation Dashboard — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env or env.js to version control.

# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:xxxxxxxxxxxxxxxx

# Firebase Admin SDK (required for mobile custom-token auth / Firestore RBAC)
# Download service account key from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Backend / Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=process_automation_db

# Seed data (demo only — change these before deploying)
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEFAULT_PASSWORD=ChangeMe123!

# Server
PORT=3001
NODE_ENV=development
PAD_API_URL=http://localhost:3001

# Mobile dev API base URL (PRFlow mobile app)
VITE_API_URL=https://localhost:3444

# Mobile demo account passwords (PRFlow offline demo mode — change these before deploying)
VITE_DEMO_ADMIN_PASSWORD=ChangeMe123!
VITE_DEMO_MANAGER_PASSWORD=ChangeMe123!
VITE_DEMO_USER_PASSWORD=ChangeMe123!
